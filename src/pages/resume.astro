---
import { portfolio, sections } from '../data/portfolio.js';
import PortfolioContent from '../components/portfolio/PortfolioContent.astro';
import '../style/fonts.styl';
import '../style/portfolio.css';
const readableSections = sections.filter(section => section.id !== 'settings');
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={portfolio.summary} />
        <title>{portfolio.name} — Projects & experience</title>
    </head>
    <body class="readable-portfolio">
        <header><a href="/">← Explore the 3D world</a><nav aria-label="Portfolio sections">{readableSections.map(section => <a href={`#${section.id}`}>{section.label}</a>)}</nav></header>
        <main>{readableSections.map(section => <section id={section.id}><PortfolioContent section={section.id} /></section>)}</main>
        <footer>© {new Date().getFullYear()} {portfolio.name}</footer>
    </body>
</html>
<style is:global>
    .readable-portfolio { margin: 0; background: #f7efdf; color: #342744; font: 16px/1.8 system-ui, sans-serif; }
    .readable-portfolio header, .readable-portfolio main, .readable-portfolio footer { max-width: 880px; padding: 24px; margin: auto; }
    .readable-portfolio nav { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 20px; }
    .readable-portfolio a { color: #6c5179; }
    .readable-portfolio section { padding: 32px 0; border-bottom: 1px solid #6c517930; scroll-margin-top: 20px; }
    .readable-portfolio .title { font-size: 30px; line-height: 1.3; }
    .readable-portfolio h1.title { font-size: clamp(32px, 6vw, 50px); }
    .readable-portfolio .tagline { font-size: 12px; color: #6c5179; text-transform: uppercase; letter-spacing: .1em; }
    .readable-portfolio .fleet-card { border: 1px solid #6c517930; border-radius: 12px; padding: 24px; margin: 20px 0; background: #e7daee; }
    .readable-portfolio .fleet-card-title { margin: 0; font-size: 22px; }
    .readable-portfolio .fleet-badge, .readable-portfolio .fleet-tagline { font-size: 12px; color: #705b80; }
    .readable-portfolio .fleet-tech { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
    .readable-portfolio .fleet-tech span { font-size: 12px; padding: 3px 10px; background: #f7efdf; border-radius: 5px; }
    .readable-portfolio .studio-actions-row, .readable-portfolio .fleet-actions { display: flex; flex-wrap: wrap; gap: 18px; }
    @media print { .readable-portfolio { color: black; background: white; } .readable-portfolio header, .readable-portfolio .portfolio-note { display: none; } .readable-portfolio .fleet-card { break-inside: avoid; background: white; } .readable-portfolio a, .readable-portfolio .tagline, .readable-portfolio .portfolio-period { color: #333; } }
</style>
