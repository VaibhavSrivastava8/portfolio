.damage-vignette
    position fixed
    inset 0
    pointer-events none
    z-index 999
    box-shadow inset 0 0 120px rgba(231, 163, 160, 0.85)
    opacity 0
    transition opacity 0.25s

    &.is-active
        opacity 1

.spatial-command-dock
    display none
    position fixed
    top 24px
    right 32px
    z-index 2000
    user-select none

    html.is-started &
        display block

    body:has(.menu.is-displayed) &,
    body:has(.modals.is-displayed) &,
    html.input-filter-intro &
        opacity 0
        pointer-events none

    .dock-container
        display flex
        align-items center
        gap 2px
        padding 4px 8px

    .dock-btn
        display inline-flex
        align-items center
        gap 6px
        padding 7px 12px
        background transparent
        border 1px solid transparent
        border-radius 8px
        cursor pointer
        font-size 12px

        .dock-icon
            font-size 12px

        .dock-kbd
            font-size 10px
            padding 2px 5px
            border-radius 4px

    .dock-divider
        width 1px
        height 20px
        margin 0 2px

.interact-prompt
    position fixed
    bottom 76px
    left 50%
    transform translateX(-50%)
    z-index 2500
    padding 10px 24px
    border-radius 24px
    cursor pointer
    opacity 0
    pointer-events none
    transition opacity 0.3s
    white-space nowrap

    &.is-visible
        opacity 1
        pointer-events auto

    html.input-filter-modal &,
    html.input-filter-menu &
        opacity 0
        pointer-events none







