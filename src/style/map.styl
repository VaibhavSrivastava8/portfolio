

.map-trigger
    display none

.map
    position relative
    width 960px
    height 960px
    max-width 92vmin
    max-height 92vmin
    aspect-ratio 1 / 1
    background #e7daee
    border-radius 16px
    border 1px solid rgba(108, 81, 121, 0.38)
    box-shadow 0 9px 0 #493451, 0 0 0 1px rgba(255, 255, 255, 0.05), 0 0 60px rgba(108, 81, 121, 0.18)
    -webkit-user-select none
    -moz-user-select none
    user-select none
    overflow hidden
    backdrop-filter none
    -webkit-backdrop-filter none

    @media only screen and (max-width 1100px)
        width 720px
        height 720px

    @media only screen and (max-width 800px)
        width 540px
        height 540px

    @media only screen and (max-width 560px)
        max-width 95vmin
        max-height 95vmin

    
    &::before
        content "Sea chart · Pick an island to travel"
        position absolute
        top 14px
        left 20px
        font-family 'Nunito', sans-serif
        font-size 10px
        font-weight 600
        color rgba(108, 81, 121, 0.75)
        letter-spacing 0.1em
        z-index 2800
        pointer-events none

    
    .close
        position absolute
        top 10px
        right 14px
        z-index 2900
        background rgba(108, 81, 121, 0.12)
        border 1px solid rgba(108, 81, 121, 0.35)
        border-radius 8px
        padding 6px 12px
        cursor pointer
        display inline-flex
        align-items center
        gap 6px
        transition all 0.2s ease
        font-family 'Nunito', sans-serif
        font-size 10.5px
        font-weight 600
        color #342744

        .button-inner
            display flex
            align-items center
            gap 6px

            .icon-container
                display flex
                align-items center

                .icon
                    display none

            &::after
                content "[ M ✕ ]"
                letter-spacing 0.05em

        &:hover
            background rgba(108, 81, 121, 0.25)
            border-color #6c5179
            color #ffffff
            box-shadow 0 0 14px rgba(108, 81, 121, 0.35)
            transform translateY(-1px)

    .map-container
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        overflow hidden

        
        .texture
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            object-fit cover
            filter none
            opacity 0
            transition opacity 0.5s ease
            pointer-events none

            &.is-visible
                opacity 0.92

        
        &::after
            content ""
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            background none
            background-size 100% 100%, 40px 40px, 40px 40px
            pointer-events none

    
    .player
        position absolute
        top 0
        left 0
        width 0
        height 0
        z-index 2500
        pointer-events none

        .ship-radar-pulse
            position absolute
            top -25px
            left -25px
            width 50px
            height 50px
            border-radius 50%
            border 1.5px solid #f5c777
            box-shadow 0 0 16px rgba(108, 81, 121, 0.8), inset 0 0 10px rgba(108, 81, 121, 0.4)
            animation map-ship-pulse 2s infinite ease-out
            pointer-events none

        .ship-icon
            position relative
            width 42px
            height 42px
            margin -21px 0 0 -21px
            display flex
            align-items center
            justify-content center
            filter drop-shadow(0 0 10px rgba(108, 81, 121, 0.9))
            transition transform 0.06s linear

            .ship-svg
                width 100%
                height 100%

    @keyframes map-ship-pulse
        0%
            transform scale(0.5)
            opacity 1
        100%
            transform scale(2.4)
            opacity 0

    
    .location
        --size 32px
        position absolute
        width var(--size)
        height var(--size)
        margin-top calc(var(--size) / -2)
        margin-left calc(var(--size) / -2)
        cursor pointer
        z-index 200

        &:hover,
        &.is-active
            z-index 2600

            .name-container .name,
            .name
                transform scale(1, 1) !important
                opacity 1 !important

            .pin
                transform scale(1.35)
                border-color #ffffff
                box-shadow 0 0 20px rgba(108, 81, 121, 1), 0 0 35px rgba(108, 81, 121, 0.6)

        .pin
            --pin-size 16px
            position absolute
            top calc(50% - calc(var(--pin-size) / 2))
            left calc(50% - calc(var(--pin-size) / 2))
            width var(--pin-size)
            height var(--pin-size)
            border-radius 50%
            background radial-gradient(circle at 35% 35%, #f5c777, #705b80 60%, #493451 100%)
            border 2px solid rgba(255, 255, 255, 0.9)
            box-shadow 0 0 12px rgba(108, 81, 121, 0.8), 0 2px 8px rgba(0, 0, 0, 0.9)
            transition transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease
            display flex
            align-items center
            justify-content center

            .pin-jewel
                width 6px
                height 6px
                border-radius 50%
                background #ffffff
                box-shadow 0 0 6px #ffffff

            &.pin-cay
                --pin-size 11px
                background radial-gradient(circle at 35% 35%, #e7daee, #6c5179 70%)
                border 1.5px solid rgba(255, 255, 255, 0.7)

                .pin-jewel
                    width 4px
                    height 4px
                    background #ffffff

        .name-container
            display flex
            justify-content center
            position absolute
            bottom calc(100% + 8px)
            left 50%
            width 0
            pointer-events none

            .name
                background #f7efdf
                border 1px solid rgba(108, 81, 121, 0.45)
                border-radius 8px
                color #342744
                padding 6px 14px
                text-align center
                font-family 'Pally-Medium', sans-serif
                font-weight 600
                font-size 12px
                line-height 1.35
                box-shadow 0 8px 24px rgba(0, 0, 0, 0.85), 0 0 16px rgba(108, 81, 121, 0.25)
                white-space nowrap
                transform-origin 50% 100%
                transform scale(0, 0)
                opacity 0
                transition transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease
                backdrop-filter none
                -webkit-backdrop-filter none

                &.name-cay
                    font-size 11px
                    padding 5px 12px
                    border-color rgba(108, 81, 121, 0.3)

                .name-text
                    color #342744

                .travel-hint
                    display block
                    font-family 'Nunito', sans-serif
                    font-size 9px
                    font-weight 600
                    color #f5c777
                    letter-spacing 0.08em
                    text-transform uppercase
                    margin-top 3px

        @media only screen and (max-width 520px)
            --size 26px
            .name-container .name
                font-size 10px
                padding 4px 8px

    
    .map-telemetry-hud
        position absolute
        bottom 16px
        left 50%
        transform translateX(-50%)
        display flex
        gap 14px
        justify-content center
        align-items center
        max-width calc(100% - 32px)
        width auto
        background #f7efdf
        border 1px solid rgba(108, 81, 121, 0.3)
        border-radius 9999px
        padding 7px 20px
        z-index 2700
        box-shadow 0 12px 32px rgba(0, 0, 0, 0.85), 0 0 16px rgba(108, 81, 121, 0.15)
        pointer-events none
        backdrop-filter none
        -webkit-backdrop-filter none

        .telemetry-divider
            width 1px
            height 14px
            background rgba(108, 81, 121, 0.3)
            flex-shrink 0

        .telemetry-item
            font-family 'Nunito', sans-serif
            font-size 10.5px
            font-weight 500
            letter-spacing 0.06em
            color #705b80
            display flex
            align-items center
            gap 6px
            white-space nowrap

            .telem-icon
                font-size 11px
                color #f5c777

            .telem-label
                color #342744
                font-weight 600

            span
                color #f5c777
                font-weight 500
