#slidecontainer,.slider {
    width: 100%
}

.slider {
    -webkit-appearance: none;
    height: 14px;
    border-radius: 5px;
    background: #d3d3d3;
    outline: 0;
    opacity: .9;
    -webkit-transition: .2s;
    transition: opacity .2s;
    width: 100%
}



.slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #232f3e;
    cursor: pointer
}

.slider::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #232f3e;
    cursor: pointer
}

#nav_menu {
