      <script>
      (function () {
        var form = document.querySelector(".home-search-form");
        var input = document.getElementById("home-search-input");
        var datalist = document.getElementById("home-tool-list");
        if (!form || !input || !datalist) { return; }
        function hrefForExactOption(value) {
          var wanted = (value || "").trim().toLowerCase();
          if (wanted === "") { return null; }
          var options = datalist.getElementsByTagName("option");
          for (var i = 0; i < options.length; i++) {
            var optionValue = (options[i].value || "").trim().toLowerCase();
            if (optionValue === wanted) { return options[i].getAttribute("data-href"); }
          }
          return null;
        }
        // One-shot navigation guard: "change" (fires on blur/datalist pick)
        // and "submit" can both trigger for the same interaction; navigating
        // twice aborts the first request.
        var navigated = false;
        function navigateTo(href) {
          if (navigated) { return; }
          navigated = true;
          window.location.href = href;
        }
        form.addEventListener("submit", function (event) {
          var href = hrefForExactOption(input.value);
          if (href) {
            event.preventDefault();
            navigateTo(href);
          }
          if (navigated) { event.preventDefault(); }
        });
        input.addEventListener("change", function () {
          var href = hrefForExactOption(input.value);
          if (href) { navigateTo(href); }
        });
      })();
      </script>

