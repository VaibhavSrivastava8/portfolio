        margin-left: 6px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.3px;
        vertical-align: middle;
        display: inline-block;
    }
    #nav_menu .lmenu-sep {
        border: 0;
        border-top: 1px dashed #e0e0e0;
        margin: 6px 12px;
        height: 0;
    }
    #nav_menu .fa-book[data-kind="guide"] {
        color: #6b7280;
    }

    /* Cycle 50 follow-up #3 - inline icon definitions for 4 star swarm headers
       not covered by the curated fa-load.css subset. Without these, IMAGE
       CONVERTER / VIDEO / DEVELOPER / DEVICE TESTS render with a blank
       square next to the label (operator screenshot 2026-05-27). Glyph
       codes are FA 4.7 webfont native; the webfont already loads via
       fa-load.css so this only adds the missing class -> glyph mapping.
       Scoped to #nav_menu to avoid cross-page leak.
       \f121=code, \f109=laptop, \f0ec=exchange-arrows (conversion),
       \f008=filmstrip (video). */
    #nav_menu .fa-code:before       { content: '\f121'; }
    #nav_menu .fa-laptop:before     { content: '\f109'; }
    #nav_menu .fa-images:before     { content: '\f0ec'; }
    #nav_menu .fa-file-video:before { content: '\f008'; }
    #nav_menu .fa-book:before       { content: '\f02d'; }
