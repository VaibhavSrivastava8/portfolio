        outline: 0
    }

    #nav_menu .w3-col.l2 {
        width: 100%;
        padding-left: 0
    }

    #nav_menu .copy-right-left {
        left: 0;
        height: 30px;
        position: absolute;
        bottom: 0;
        line-height: 30px;
        width: 240px;
        padding-left: 15px;
        background-color: #fff
    }

    @media(max-width: 768px) {
        #nav_menu {
            width:100%;
            border-right: 0
        }

        #nav_menu .copy-right-left {
            display: none
        }

        #nav_menu .w3-row-padding {
            padding-bottom: 120px
        }
    }

	#nav_menu {
		z-index: 2;
	}

    html.menu-open>body:after {
        z-index: 1 !important;
    }

    /* Dynamic-l-menu kind indicators (cycle 50 follow-up: distinguish tool
       vs guide items now that l-menu is build-generated from JSP_BY_ROUTE
       + GUIDE_ROUTES). See sitemap-html-builder.mjs::buildDynamicLMenuBody. */
    #nav_menu .lmenu-kind-badge {
        font-size: 10px;
        color: #777;
        background: #f0f0f0;
        border: 1px solid #ddd;
        padding: 1px 5px;
