<script>
    // plan-warm-pascal-v3 S3.2: l-menu locale-aware guide-link rewrite.
    // When the current page is a locale-prefixed guide (<html lang> in
    // pt/es/vi/id/de), rewrite the GUIDES sub-menu items from the EN
    // canonical /guides/<slug>.html to /guides/<lang>/<slug>.html so the
    // reader stays in their locale when clicking another guide. Already-
    // localised links and non-guide links pass through unchanged.
    (function() {
        var SUPPORTED = {"pt":1,"es":1,"vi":1,"id":1,"de":1};
        try {
            var lang = (document.documentElement.getAttribute("lang") || "").toLowerCase().slice(0, 2);
            if (!SUPPORTED[lang]) return;
            // Wait for DOMContentLoaded so the inlined l-menu HTML is parsed.
            var apply = function() {
                var menu = document.getElementById("guidesMenu");
                if (!menu) return;
                var anchors = menu.getElementsByTagName("a");
                for (var i = 0; i < anchors.length; i++) {
                    var href = anchors[i].getAttribute("href") || "";
                    // Match /guides/<bare-slug>.html (EN canonical). Already-
                    // localised hrefs and non-guide hrefs pass through.
                    var m = /^(https?:\/\/[^\/]+)?(\/guides\/)([a-z0-9-]+\.html)$/.exec(href);
                    if (!m) continue;
                    var origin = m[1] || "";
                    anchors[i].setAttribute("href", origin + "/guides/" + lang + "/" + m[3]);
                }
            };
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", apply, { once: true });
            } else {
                apply();
            }
        } catch (e) { /* fall through to non-localised links */ }
    })();

    fixIOSOverplayScrolling = function(_overlayId) {
        try {
            (function() {
                var _overlay = document.getElementById(_overlayId);
                var _clientY = null; // remember Y position on touch start

                _overlay.addEventListener('touchstart', function(event) {
                    if (event.targetTouches.length === 1) {
                        // detect single touch
                        _clientY = event.targetTouches[0].clientY;
                    }
                }, false);

                _overlay.addEventListener('touchmove', function(event) {
                    if (event.targetTouches.length === 1) {
                        // detect single touch
                        disableRubberBand(event);
                    }
                }, false);

                function disableRubberBand(event) {
                    var clientY = event.targetTouches[0].clientY - _clientY;

                    if (_overlay.scrollTop === 0 && clientY > 0) {
                        // element is at the top of its scroll
                        event.preventDefault();
                    }

                    if (isOverlayTotallyScrolled() && clientY < 0) {
                        //element is at the top of its scroll
                        event.preventDefault();
                    }
                }

                function isOverlayTotallyScrolled() {
                    // https://developer.mozilla.org/en-US/docs/Web/API/Element/scrollHeight#Problems_and_solutions
                    return _overlay.scrollHeight - _overlay.scrollTop <= _overlay.clientHeight;
                }
            }());
        } catch (e) {
            console.log(e)
        }
    };

    document.addEventListener(
        'DOMContentLoaded',
        function() {
            try {
                if (typeof window.$ !== 'function') {
                    return;
                }

                $('.menuToogle').removeAttr('onclick');
                $('body.new-style-body').click(function() {
                    ($('html.menu-open').length > 0 && isClickedToggle) ? toggleMenu() : '';
                });
                $('.menuToogle').click(function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleMenu();
                });
                $('#menu-content-id, #mainNavBar').click(function(e) {
                    e.stopPropagation();
                });

                focusCurrentMenu = function(_el) {
                    var pageHref = $('.pageNameContainer').attr('href');
                    if (!pageHref) return;
                    var normalizePath = function(href) {
                        try {
                            var p = new URL(href, window.location.origin).pathname;
                            p = p.replace(/\/index\.html$/, '/');
                            return p === '' ? '/' : p;
                        } catch (e) { return null; }
                    };
                    var pagePath = normalizePath(pageHref);
                    if (!pagePath) return;
                    $('#nav_menu').find(_el).each(function() {
                        var linkHref = $(this).attr('href');
                        if (!linkHref || linkHref.indexOf('javascript:') === 0) return;
                        var linkPath = normalizePath(linkHref);
                        if (linkPath === null || linkPath !== pagePath) return;
                        $(this).addClass('active');
                        $("#nav_menu .menuGroup").removeClass("w3-show");
                        $(this).closest('.menuGroup').addClass('w3-show');
                        $('#nav_menu .menu-content').scrollTop($(this).offset().top);
                    });
                };

                // Ensure current route is highlighted even when the menu is inlined (static build).
                try {
                    focusCurrentMenu('a');
                } catch (e) {}
            } catch (e) {
                console.log(e);
            }
        },
        { once: true }
    );
</script>

