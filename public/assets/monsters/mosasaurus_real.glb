    <script>
    (function () {
      var host = document.getElementById("knowledge-explorer");
      if (!host || !window.matchMedia) { return; }
      var mq = window.matchMedia("(min-width: 1024px)");
      var loaded = false;
      function boot() {
        if (loaded || !mq.matches) { return; }
        loaded = true;
        var base = host.getAttribute("data-base") || "";
        var lib = document.createElement("script");
        lib.src = host.getAttribute("data-lib");
        lib.onload = function () {
          var app = document.createElement("script");
          app.src = base + "/script/knowledge-graph.js?v=" + (window.APP_VERSION || "1");
          document.body.appendChild(app);
        };
        lib.onerror = function () {
          var hint = document.getElementById("ke-graph-hint");
          if (hint) { hint.textContent = "The 3D map could not load here. The directory on the left lists every page."; }
        };
        document.body.appendChild(lib);
      }
      if (mq.matches) {
        if ("requestIdleCallback" in window) { requestIdleCallback(boot, { timeout: 3000 }); }
        else { setTimeout(boot, 500); }
      }
      if (mq.addEventListener) { mq.addEventListener("change", boot); }
      else if (mq.addListener) { mq.addListener(boot); }
    })();
    </script>
